-- ============ MAIN HEARTBEAT LOOP ============
-- Re-scans workspace.Characters every heartbeat: adds new creatures,
-- updates existing ones, and removes ones that despawned.
RunService.Heartbeat:Connect(function()
	if not ESPEnabled then
		-- keep entries alive (so we don't lose maxHealth tracking) but hide them
		for _, data in pairs(espData) do
			data.frame.Visible = false
		end
		return
	end

	local seen = {}

	for _, model in ipairs(charactersFolder:GetChildren()) do
		if model:IsA("Model") and model.Name ~= player.Name then
			seen[model] = true

			if not espData[model] then
				espData[model] = createEntry()
			end

			updateEntry(model, espData[model])
		end
	end

	-- Clean up despawned creatures
	for model in pairs(espData) do
		if not seen[model] then
			destroyEntry(model)
		end
	end
end)
