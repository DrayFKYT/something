RunService.Heartbeat:Connect(function()
    -- Admin Check
    for _, player in ipairs(Players:GetPlayers()) do
        if checkPlayer(player) then break end
    end

    -- Attribute Enforcement
    local char = LocalPlayer.Character
    local data = char and char:FindFirstChild("Data")
    
    -- Always Climber Enforcement
    local charactersFolder = workspace:FindFirstChild("Characters")
    if charactersFolder then
        local playerFolder = charactersFolder:FindFirstChild(LocalPlayer.Name)
        local climberData = playerFolder and playerFolder:FindFirstChild("Data")
        if climberData then
            climberData:SetAttribute("Climber", AlwaysClimberToggled)
        end
    end

    if not data then return end
    
    if InfiniteStaminaToggled then
        data:SetAttribute("st", 99999999999999)
        data:SetAttribute("sr", 99999999999999)
    end
    if InfiniteOxygenToggled then data:SetAttribute("Oxygen", 99999999999999) end
    if InfiniteMoistureToggled then data:SetAttribute("Moisture", 99999999999999) end
    
    if WalkEnabled then data:SetAttribute("s", WalkSpeedValue) end
    if SprintEnabled then data:SetAttribute("ss", SprintSpeedValue) end
    if FlyEnabled then data:SetAttribute("fs", FlySpeedValue) end

    if ScentToggled then
        char:SetAttribute("ScentHidden", true)
        if HideScentRemote then HideScentRemote:FireServer(true) end
    end
    if AggressionToggled and StateAilmentRemote then StateAilmentRemote:FireServer("Aggression") end
    if CowerToggled and StateAilmentRemote then StateAilmentRemote:FireServer("Cower") end
end)

-- Exploit Fly Logic (CFrame Based)
RunService.RenderStepped:Connect(function(deltaTime)
    if not ExploitFlyEnabled then return end

    local character = LocalPlayer.Character
    if not character then return end

    local root = character.PrimaryPart or character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    if not currentFlyPosition then
        currentFlyPosition = root.Position
    end

    local moveVector = Vector3.zero

    if flyInputs.W then moveVector += camera.CFrame.LookVector end
    if flyInputs.S then moveVector -= camera.CFrame.LookVector end
    if flyInputs.D then moveVector += camera.CFrame.RightVector end
    if flyInputs.A then moveVector -= camera.CFrame.RightVector end
    if flyInputs.Space then moveVector += Vector3.new(0, 1, 0) end
    if flyInputs.LeftShift then moveVector -= Vector3.new(0, 1, 0) end

    if moveVector.Magnitude > 0 then
        moveVector = moveVector.Unit
    end

    local translation = moveVector * ExploitFlySpeed * deltaTime
    currentFlyPosition += translation
    
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.CFrame = CFrame.new(currentFlyPosition) * root.CFrame.Rotation
end)


