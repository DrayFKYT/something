-- Exploit Fly Logic (CFrame Based)
RunService.RenderStepped:Connect(function(deltaTime)
    if not ExploitFlyEnabled then return end

    local character = LocalPlayer.Character
    if not character then return end

    local root = character.PrimaryPart or character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    if not currentFlyPosition then
        currentFlyPosition = root.Position
    end

    local moveVector = Vector3.zero

    if flyInputs.W then moveVector += camera.CFrame.LookVector end
    if flyInputs.S then moveVector -= camera.CFrame.LookVector end
    if flyInputs.D then moveVector += camera.CFrame.RightVector end
    if flyInputs.A then moveVector -= camera.CFrame.RightVector end
    if flyInputs.Space then moveVector += Vector3.new(0, 1, 0) end
    if flyInputs.LeftShift then moveVector -= Vector3.new(0, 1, 0) end

    if moveVector.Magnitude > 0 then
        moveVector = moveVector.Unit
    end

    local translation = moveVector * ExploitFlySpeed * deltaTime
    currentFlyPosition += translation
    
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.CFrame = CFrame.new(currentFlyPosition) * root.CFrame.Rotation
end)


