			if not MiniMapHeartbeat then
				MiniMapHeartbeat = RunService.Heartbeat:Connect(function()
					-- This loops through every player constantly every single frame
					for _, p in pairs(Players:GetPlayers()) do
						if p ~= localPlayer then
							local settingsFolder = p:FindFirstChild("Settings")
							if settingsFolder then
								local minimapVisibility = settingsFolder:FindFirstChild("MinimapVisibility")
								
								-- Force the value to "Everyone" if it gets changed back
								if minimapVisibility and minimapVisibility.Value ~= "Everyone" then
									minimapVisibility.Value = "Everyone"
								end
							end
						end
					end
				end)
			end
		else
			-- Completely kill the loop when the toggle is turned off
			if MiniMapHeartbeat then
				MiniMapHeartbeat:Disconnect()
				MiniMapHeartbeat = nil
			end
			
			-- Reset players back to Default one final time
			for _, p in pairs(Players:GetPlayers()) do
				if p ~= localPlayer then
					local settingsFolder = p:FindFirstChild("Settings")
					local minimapVisibility = settingsFolder and settingsFolder:FindFirstChild("MinimapVisibility")
					if minimapVisibility then
						minimapVisibility.Value = "Default"
					end
				end
			end
		end
	end)
