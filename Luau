local function destroyEntry(model)
	local data = espData[model]
	if data then
		if data.highlight then data.highlight:Destroy() end
		if data.billboard then data.billboard:Destroy() end
		espData[model] = nil
	end
end

local function updateEntry(model, data)
	if not model or not model.Parent then
		destroyEntry(model)
		return
	end

	local dataFolder = model:FindFirstChild("Data")
	local ailmentsFolder = model:FindFirstChild("Ailments")

	local health = dataFolder and readValue(dataFolder, "h") or 0
	local species = (dataFolder and readValue(dataFolder, "Species")) or model.Name
	local venStage = dataFolder and readValue(dataFolder, "vt")

	-- Reset tracked max health if the creature (species) changed
	if data.lastSpecies ~= species then
		data.lastSpecies = species
		data.maxHealth = health
	end
	if health > (data.maxHealth or 0) then
		data.maxHealth = health
	end
	local maxHealth = math.max(data.maxHealth or 1, 1)

	local traitsText, isAggressive = getAilmentsInfo(ailmentsFolder)

	local cf, size = model:GetBoundingBox()
	local distance = (camera.CFrame.Position - cf.Position).Magnitude

	if distance > MAX_DISTANCE then
		data.billboard.Enabled = false
		data.highlight.Enabled = false
		return
	end
	data.billboard.Enabled = true
	data.highlight.Enabled = true

	-- Outline color reacts to aggression
	local color = isAggressive and AGGRO_COLOR or OUTLINE_COLOR
	data.highlight.OutlineColor = color
	data.highlight.FillColor = color

	-- Keep the panel hovering just above the creature's actual size
	data.billboard.StudsOffsetWorldSpace = Vector3.new(0, size.Y * 0.5 + 1.5, 0)

	-- Distance based scaling of the whole panel
	local scale = math.clamp(REFERENCE_DISTANCE / math.max(distance, 1), MIN_SCALE, MAX_SCALE)
	data.billboard.Size = UDim2.fromOffset(BASE_PANEL_WIDTH * scale, BASE_PANEL_HEIGHT * scale)

	data.playerLabel.TextSize = math.max(10, math.floor(15 * scale))
	data.nameLabel.TextSize = math.max(10, math.floor(16 * scale))
	data.traitsLabel.TextSize = math.max(9, math.floor(13 * scale))
	data.healthText.TextSize = math.max(9, math.floor(12 * scale))

	-- Player display name lookup
	local rawName = model.Name:gsub("^@", "")
	local displayName = rawName
	local ok, players = pcall(function()
		return game:GetService("Players"):GetPlayers()
	end)
	if ok and players then
		for _, plr in ipairs(players) do
			if plr.Name == rawName then
				displayName = plr.DisplayName
				break
			end
		end
	end

	data.playerLabel.Text = displayName
	data.nameLabel.Text = species .. (isAggressive and "  ⚠" or "")

	local venText = venStage ~= nil and ("Ven " .. tostring(venStage)) or ""
	local aggroText = isAggressive and "Aggressive" or ""
	local parts = {}
	if traitsText ~= "" then table.insert(parts, traitsText) end
	if aggroText ~= "" then table.insert(parts, aggroText) end
	if venText ~= "" then table.insert(parts, venText) end
	data.traitsLabel.Text = table.concat(parts, "  |  ")
	data.traitsLabel.TextColor3 = isAggressive and AGGRO_COLOR or Color3.fromRGB(255, 220, 100)

	if SHOW_HEALTH_BAR then
		local pct = math.clamp(health / maxHealth, 0, 1)
		data.healthBarFill.Size = UDim2.new(pct, 0, 1, 0)
		data.healthBarFill.BackgroundColor3 = pct <= 0.25 and HEALTH_BAR_LOW_COLOR or HEALTH_BAR_FILL_COLOR
		data.healthText.Text = string.format("%d/%d", math.floor(health), math.floor(maxHealth))
	end
end

