-- Reads an attribute, falling back to a child instance's .Value if the attribute isn't set
local function readValue(instance, name)
	local attr = instance:GetAttribute(name)
	if attr ~= nil then
		return attr
	end
	local child = instance:FindFirstChild(name)
	if child and child:IsA("ValueBase") then
		return child.Value
	end
	return nil
end

-- Pulls trait letters ("H/S") and aggression flag out of the Ailments folder's ATTRIBUTES
-- e.g. an attribute named "HealthTrait" -> "H", "SpeedTrait" -> "S"
-- An "Aggressive"/"Aggro" attribute only exists on the folder when the creature is aggressive
local function getAilmentsInfo(ailmentsFolder)
	local traitLetters = {}
	local isAggressive = false

	if ailmentsFolder then
		for attrName, attrValue in pairs(ailmentsFolder:GetAttributes()) do
			local lowerName = string.lower(attrName)

			if string.find(lowerName, "trait") then
				-- strip the trailing "trait" so "HealthTrait" -> "Health" -> "H"
				local base = attrName:gsub("[Tt][Rr][Aa][Ii][Tt]$", "")
				if base == "" then
					base = attrName
				end
				table.insert(traitLetters, string.upper(string.sub(base, 1, 1)))
			elseif string.find(lowerName, "aggro") or string.find(lowerName, "aggress") then
				isAggressive = (attrValue ~= false)
			end
		end
	end

	return table.concat(traitLetters, "/"), isAggressive
end

local function updateEntry(model, data)
	if not model or not model.Parent then
		destroyEntry(model)
		return
	end

	local dataFolder = model:FindFirstChild("Data")
	local ailmentsFolder = model:FindFirstChild("Ailments")

	local health = dataFolder and readValue(dataFolder, "h") or 0
	local species = (dataFolder and readValue(dataFolder, "Species")) or model.Name
	local venStage = dataFolder and readValue(dataFolder, "vt")

	-- Reset tracked max health if the creature (species) changed
	if data.lastSpecies ~= species then
		data.lastSpecies = species
		data.maxHealth = health
	end
	if health > (data.maxHealth or 0) then
		data.maxHealth = health
	end
	local maxHealth = math.max(data.maxHealth or 1, 1)

	local traitsText, isAggressive = getAilmentsInfo(ailmentsFolder)

	-- ---- Bounding box -> screen space ----
	local cf, size = model:GetBoundingBox()
	local distance = (camera.CFrame.Position - cf.Position).Magnitude

	if distance > MAX_DISTANCE then
		data.frame.Visible = false
		return
	end

	local halfSize = size * 0.5
	local corners = {
		cf * Vector3.new(-halfSize.X, -halfSize.Y, -halfSize.Z),
		cf * Vector3.new(-halfSize.X, -halfSize.Y,  halfSize.Z),
		cf * Vector3.new(-halfSize.X,  halfSize.Y, -halfSize.Z),
		cf * Vector3.new(-halfSize.X,  halfSize.Y,  halfSize.Z),
		cf * Vector3.new( halfSize.X, -halfSize.Y, -halfSize.Z),
		cf * Vector3.new( halfSize.X, -halfSize.Y,  halfSize.Z),
		cf * Vector3.new( halfSize.X,  halfSize.Y, -halfSize.Z),
		cf * Vector3.new( halfSize.X,  halfSize.Y,  halfSize.Z),
	}

	local minX, minY = math.huge, math.huge
	local maxX, maxY = -math.huge, -math.huge
	local anyOnScreen = false

	for _, corner in ipairs(corners) do
		local screenPoint, onScreen = camera:WorldToViewportPoint(corner)
		if onScreen then anyOnScreen = true end
		minX = math.min(minX, screenPoint.X)
		minY = math.min(minY, screenPoint.Y)
		maxX = math.max(maxX, screenPoint.X)
		maxY = math.max(maxY, screenPoint.Y)
	end

	local _, cfOnScreen = camera:WorldToViewportPoint(cf.Position)
	if not cfOnScreen and not anyOnScreen then
		data.frame.Visible = false
		return
	end

	local width = maxX - minX
	local height = maxY - minY

	data.frame.Position = UDim2.fromOffset(minX, minY)
	data.frame.Size = UDim2.fromOffset(width, height)
	data.frame.Visible = true

	local edges = data.edges
	local boxColor = isAggressive and AGGRO_COLOR or BOX_COLOR

	edges.top.BackgroundColor3 = boxColor
	edges.bottom.BackgroundColor3 = boxColor
	edges.left.BackgroundColor3 = boxColor
	edges.right.BackgroundColor3 = boxColor

	edges.top.Size = UDim2.new(1, 0, 0, BOX_THICKNESS)
	edges.top.Position = UDim2.new(0, 0, 0, 0)

	edges.bottom.Size = UDim2.new(1, 0, 0, BOX_THICKNESS)
	edges.bottom.Position = UDim2.new(0, 0, 1, -BOX_THICKNESS)

	edges.left.Size = UDim2.new(0, BOX_THICKNESS, 1, 0)
	edges.left.Position = UDim2.new(0, 0, 0, 0)

	edges.right.Size = UDim2.new(0, BOX_THICKNESS, 1, 0)
	edges.right.Position = UDim2.new(1, -BOX_THICKNESS, 0, 0)

	-- ---- Labels ----
	data.playerLabel.Text = model.Name
	data.nameLabel.Text = species .. (isAggressive and "  ⚠" or "")

	local venText = venStage ~= nil and ("Ven " .. tostring(venStage)) or ""
	local aggroText = isAggressive and "Aggressive" or ""

	local parts = {}
	if traitsText ~= "" then table.insert(parts, traitsText) end
	if aggroText ~= "" then table.insert(parts, aggroText) end
	if venText ~= "" then table.insert(parts, venText) end

	data.traitsLabel.Text = table.concat(parts, "  |  ")
	data.traitsLabel.TextColor3 = isAggressive and AGGRO_COLOR or Color3.fromRGB(255, 220, 100)

	-- ---- Health bar ----
	if SHOW_HEALTH_BAR then
		local pct = math.clamp(health / maxHealth, 0, 1)
		data.healthBarFill.Size = UDim2.new(pct, 0, 1, 0)
		data.healthBarFill.BackgroundColor3 = pct <= 0.25 and HEALTH_BAR_LOW_COLOR or HEALTH_BAR_FILL_COLOR
		data.healthText.Text = string.format("%d/%d", math.floor(health), math.floor(maxHealth))
	end
end

